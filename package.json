{
  "name": "tranjs-monorepo",
  "private": true,
  "version": "1.0.2",
  "description": "Node.js transaction management framework inspired by Spring's `@Transactional` annotation.",
  "scripts": {
    "build": "tsc -b",
    "test": "lerna run test",
    "test:postgres:v3": "node scripts/test/postgres-v3.cjs",
    "test:runners": "node scripts/test/runner-matrix/run.cjs",
    "test:packed": "node scripts/test/packed-consumer.cjs",
    "test:legacy": "bash scripts/legacy-smoke.sh",
    "test:types": "tsc -p test/types/tsconfig.json --noEmit && tsc -p test/types/tsconfig.testing-node10.json --noEmit && tsc -p test/types/tsconfig.testing-node16.json --noEmit && tsc -p test/types/tsconfig.testing-bundler.json --noEmit",
    "test:types:postgres:v3": "tsc -p test/types/tsconfig.postgres-v3.json --noEmit",
    "publish": "lerna run test && npm run build && lerna publish"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/asheswook/tranjs.git"
  },
  "keywords": [
    "transaction",
    "transactional",
    "typeorm",
    "orm",
    "database",
    "query"
  ],
  "engines": {
    "node": ">=16.4.0"
  },
  "author": "asheswook",
  "license": "LGPL-2.1-only",
  "bugs": {
    "url": "https://github.com/asheswook/tranjs/issues"
  },
  "homepage": "https://github.com/asheswook/tranjs#readme",
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "lerna": "^8.1.9",
    "postgres-v3": "npm:postgres@^3.4.9",
    "ts-jest": "^29.2.5",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "reflect-metadata": "^0.2.2"
  }
}
