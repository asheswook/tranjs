{
  "name": "@tranjs/postgres",
  "license": "LGPL-2.1-only",
  "repository": { "type": "git", "url": "https://github.com/asheswook/tranjs.git", "directory": "packages/postgres" },
  "version": "1.3.0",
  "description": "TranJS driver for postgres.js. (PostgreSQL)",
  "homepage": "https://github.com/asheswook/tranjs#readme",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "package.json",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@tranjs/core": "^1.3.0",
    "postgres": "^3.4.0 || ^4.1.0"
  },
  "jest": {
    "collectCoverage": true,
    "collectCoverageFrom": [
      "src/**/*.ts"
    ],
    "coverageReporters": [
      "json",
      "json-summary",
      "text",
      "html"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 96.4,
        "branches": 83.1,
        "functions": 97.6,
        "lines": 99.2
      }
    },
    "testEnvironment": "node",
    "testRegex": ".*\\.spec\\.ts$",
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "transform": {
      "/node_modules/postgres/.+\\.js$": "<rootDir>/../../scripts/test/postgres-transform.cjs",
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": {
            "module": "commonjs",
            "moduleResolution": "node"
          }
        }
      ]
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!postgres/)"
    ],
    "testTimeout": 30000
  },
  "devDependencies": {
    "@tranjs/testing": "1.2.0",
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5"
  }
}
