{
  "name": "@tranjs/postgres",
  "version": "1.0.0",
  "description": "TranJS driver for postgres.js. (PostgreSQL)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "tsc -b",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@tranjs/core": "^1.1.0",
    "postgres": "*"
  },
  "jest": {
    "testEnvironment": "node",
    "testRegex": ".*\\.spec\\.ts$",
    "moduleFileExtensions": ["js", "json", "ts"],
    "transform": {
      "/node_modules/postgres/.+\\.js$": "<rootDir>/../../scripts/test/postgres-transform.cjs",
      "^.+\\.ts$": "ts-jest"
    },
    "transformIgnorePatterns": ["/node_modules/(?!postgres/)"],
    "testTimeout": 30000
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5"
  }
}
