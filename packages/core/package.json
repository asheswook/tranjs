{
  "name": "@tranjs/core",
  "version": "1.2.0",
  "description": "Node.js transaction management framework inspired by Spring's `@Transactional` annotation.",
  "scripts": {
    "build": "tsc -b",
    "test": "jest"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/asheswook/tranjs.git"
  },
  "keywords": [
    "transaction",
    "transactional",
    "database",
    "query"
  ],
  "engines": {
    "node": ">=16.4.0"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./dist/asyncLocal": "./dist/asyncLocal.js",
    "./internal/testing-bridge": "./dist/internal/testing-bridge.js"
  },
  "typesVersions": {
    "*": {
      "internal/testing-bridge": ["dist/internal/testing-bridge.d.ts"]
    }
  },
  "files": [
    "dist",
    "package.json",
    "README.md"
  ],
  "types": "./dist/index.d.ts",
  "author": "asheswook",
  "license": "LGPL-2.1-only",
  "bugs": {
    "url": "https://github.com/asheswook/tranjs/issues"
  },
  "homepage": "https://github.com/asheswook/tranjs#readme",
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5"
  },
  "gitHead": "7eff63661a41cb6adecdafb88eea4adb7726ef61",
  "jest": {
    "collectCoverage": true,
    "coverageReporters": [
      "json",
      "json-summary",
      "text",
      "html"
    ],
    "moduleDirectories": [
      "<rootDir>",
      "node_modules",
      "src"
    ],
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "./",
    "roots": ["<rootDir>/test", "<rootDir>/src"],
    "moduleNameMapper": {
      "^@tranjs/core$": "<rootDir>/src",
      "^@tranjs/core/internal/testing-bridge$": "<rootDir>/src/internal/testing-bridge"
    },
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": ["ts-jest", {
        "tsconfig": {
          "baseUrl": ".",
          "paths": {
            "@tranjs/core": ["src"],
            "@tranjs/core/internal/testing-bridge": ["src/internal/testing-bridge"]
          }
        }
      }]
    },
    "collectCoverageFrom": [
      "src/**/*.ts"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 94.3,
        "branches": 89.7,
        "functions": 85.9,
        "lines": 94.2
      },
      "./src/manager.ts": {},
      "./src/internal": {}
    },
    "testEnvironment": "node",
    "coverageDirectory": "coverage"
  }
}
