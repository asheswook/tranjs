{
  "name": "@tranjs/core",
  "version": "1.1.0",
  "description": "Node.js transaction management framework inspired by Spring's `@Transactional` annotation.",
  "scripts": {
    "build": "tsc -b",
    "test": "jest"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/asheswook/tranjs.git"
  },
  "keywords": [
    "transaction",
    "transactional",
    "typeorm",
    "orm",
    "database",
    "query"
  ],
  "engines": {
    "node": ">=16.4.0"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./testing": "./dist/testing/index.js",
    "./testing/jest": "./dist/testing/jest.js",
    "./testing/vitest": {
      "types": "./dist/testing/vitest.d.mts",
      "import": "./dist/testing/vitest.mjs"
    },
    "./dist/asyncLocal": "./dist/asyncLocal.js",
    "./internal/testing-bridge": "./dist/internal/testing-bridge.js"
  },
  "typesVersions": {
    "*": {
      "internal/testing-bridge": ["dist/internal/testing-bridge.d.ts"],
      "testing": ["dist/testing/index.d.ts"],
      "testing/jest": ["dist/testing/jest.d.ts"],
      "testing/vitest": ["dist/testing/vitest.d.mts"]
    }
  },
  "files": [
    "dist",
    "package.json",
    "README.md"
  ],
  "types": "./dist/index.d.ts",
  "author": "asheswook",
  "license": "LGPL-2.1-only",
  "bugs": {
    "url": "https://github.com/asheswook/tranjs/issues"
  },
  "homepage": "https://github.com/asheswook/tranjs#readme",
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "@jest/globals": "^29.7.0",
    "expect": "^29.7.0",
    "vitest": "^3.2.7",
    "ts-jest": "^29.2.5"
  },
  "peerDependencies": {
    "jest": "^29.7.0 || ^30.0.0",
    "@jest/globals": "^29.7.0 || ^30.0.0",
    "expect": "^29.7.0 || ^30.0.0",
    "vitest": "^3.0.0 || ^4.0.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "jest": { "optional": true },
    "@jest/globals": { "optional": true },
    "expect": { "optional": true },
    "vitest": { "optional": true }
  },
  "gitHead": "7eff63661a41cb6adecdafb88eea4adb7726ef61",
  "jest": {
    "collectCoverage": true,
    "coverageReporters": [
      "json",
      "json-summary",
      "text",
      "html"
    ],
    "moduleDirectories": [
      "<rootDir>",
      "node_modules",
      "src"
    ],
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "./",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.ts"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 94.3,
        "branches": 89.7,
        "functions": 85.9,
        "lines": 94.2
      }
    },
    "testEnvironment": "node",
    "coverageDirectory": "coverage"
  }
}
