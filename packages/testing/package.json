{
  "name": "@tranjs/testing",
  "version": "1.2.0",
  "description": "Transaction testing helpers and assertions for TranJS.",
  "license": "LGPL-2.1-only",
  "engines": { "node": ">=16.4.0" },
  "scripts": { "build": "tsc -b", "test": "jest --runInBand" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./jest": "./dist/jest.js",
    "./vitest": { "types": "./dist/vitest.d.mts", "import": "./dist/vitest.mjs" }
  },
  "typesVersions": {
    "*": { "jest": ["dist/jest.d.ts"], "vitest": ["dist/vitest.d.mts"] }
  },
  "files": ["dist", "package.json", "README.md"],
  "sideEffects": ["./dist/bridge.js", "./dist/jest.js", "./dist/vitest.mjs"],
  "peerDependencies": {
    "@tranjs/core": "1.2.0",
    "jest": "^29.7.0 || ^30.0.0",
    "@jest/globals": "^29.7.0 || ^30.0.0",
    "expect": "^29.7.0 || ^30.0.0",
    "vitest": "^3.0.0 || ^4.0.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "jest": { "optional": true },
    "@jest/globals": { "optional": true },
    "expect": { "optional": true },
    "vitest": { "optional": true }
  },
  "devDependencies": {
    "@tranjs/core": "1.2.0",
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "@jest/globals": "^29.7.0",
    "expect": "^29.7.0",
    "vitest": "^3.2.7",
    "ts-jest": "^29.2.5"
  },
  "jest": {
    "collectCoverage": true,
    "collectCoverageFrom": ["src/**/*.ts"],
    "coverageReporters": ["json", "json-summary", "text", "html"],
    "coverageThreshold": {
      "global": { "statements": 94.3, "branches": 89.7, "functions": 85.9, "lines": 94.2 }
    },
    "moduleNameMapper": {
      "^@tranjs/core$": "<rootDir>/../core/src",
      "^@tranjs/core/internal/testing-bridge$": "<rootDir>/../core/src/internal/testing-bridge"
    },
    "roots": ["<rootDir>/test", "<rootDir>/../core/test"],
    "testMatch": ["<rootDir>/test/**/*.spec.ts", "<rootDir>/../core/test/fixture.spec.ts"],
    "moduleFileExtensions": ["js", "json", "ts"],
    "transform": {
      "^.+\\.(t|j)s$": ["ts-jest", {
        "tsconfig": {
          "baseUrl": ".",
          "paths": {
            "@tranjs/core": ["../core/src"],
            "@tranjs/core/internal/testing-bridge": ["../core/src/internal/testing-bridge"]
          }
        }
      }]
    },
    "testEnvironment": "node",
    "coverageDirectory": "coverage"
  }
}
