{
  "name": "@tranjs/mysql2",
  "license": "LGPL-2.1-only",
  "repository": { "type": "git", "url": "https://github.com/asheswook/tranjs.git", "directory": "packages/mysql2" },
  "version": "1.3.1",
  "description": "TranJS driver for mysql2. (MySQL)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@tranjs/core": "^1.2.1",
    "mysql2": "*"
  },
  "jest": {
    "collectCoverage": true,
    "collectCoverageFrom": [
      "src/**/*.ts"
    ],
    "coverageReporters": [
      "json",
      "json-summary",
      "text",
      "html"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 98.2,
        "branches": 85,
        "functions": 99.9,
        "lines": 99
      }
    },
    "testEnvironment": "node",
    "testRegex": ".*\\.spec\\.ts$",
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testTimeout": 30000
  },
  "gitHead": "7eff63661a41cb6adecdafb88eea4adb7726ef61",
  "devDependencies": {
    "@tranjs/testing": "1.2.0",
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5"
  }
}
